@model BE1.Models.Customer

@{
    ViewBag.Title = "Đăng nhập tài khoản - Lubu Store";
    Layout = "~/Areas/Customer/Views/Shared/_CustomerLayout.cshtml";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-title">Đăng Nhập Lubu Store</div>

        <!-- KẾT NỐI TRỰC TIẾP VỚI ACCOUNTCONTROLLER / LOGIN (POST) -->
        @using (Html.BeginForm("Login", "Account", new { area = "Customer", returnUrl = Request.QueryString["returnUrl"] }, FormMethod.Post, new { id = "login-form" }))
        {
            @Html.AntiForgeryToken()

            <!-- Hiển thị thông báo thành công nếu vừa đăng ký xong -->
            if (TempData["SuccessMessage"] != null)
            {
                <div class="alert-success-msg">
                    @TempData["SuccessMessage"]
                </div>
            }

            <!-- Hiển thị thông báo lỗi khi đăng nhập thất bại -->
            @Html.ValidationSummary(true, "", new { @class = "alert-error-msg" })

            <div class="form-group">
                <label class="form-label">Địa chỉ Email</label>
                @Html.TextBoxFor(model => model.CustomerEmail, new { @type = "email", @class = "form-input", @placeholder = "nhapemail@domain.com", @required = "required" })
                @Html.ValidationMessageFor(model => model.CustomerEmail, "", new { @class = "field-error" })
            </div>

            <div class="form-group">
                <label class="form-label">Mật khẩu</label>
                @Html.PasswordFor(model => model.Password, new { @class = "form-input", @placeholder = "••••••••", @required = "required" })
                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "field-error" })
            </div>

            <div class="forgot-password">
                <a href="#">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn-submit">Đăng Nhập</button>
        }

        <div class="auth-switch">
            Chưa có tài khoản? <a href="@Url.Action("Register", "Account", new { area = "Customer" })">Đăng ký tài khoản mới ></a>
        </div>
    </div>
</div>

<style>
    .auth-wrapper {
        min-height: calc(100vh - 70px);
        display: flex;
        justify-content: center;
        align-items: center;
        background-image: url("/content/image2/5-1.jpg");
        background-size: cover;
        background-position: center;
        padding: 40px 20px;
    }

    .auth-card {
        background-color: white;
        border: 1px solid #e2e8f0;
        width: 100%;
        max-width: 440px;
        padding: 40px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
        border-radius: 12px;
    }

    .auth-title {
        color: #111827;
        font-size: 22px;
        font-weight: 700;
        text-align: center;
        margin-bottom: 25px;
        letter-spacing: -0.5px;
    }

    .alert-success-msg {
        background-color: #d1fae5;
        color: #065f46;
        padding: 10px 14px;
        border-radius: 6px;
        font-size: 13px;
        margin-bottom: 15px;
        text-align: center;
        font-weight: 600;
    }

    .alert-error-msg {
        color: #dc2626;
        font-size: 13px;
        margin-bottom: 15px;
        text-align: center;
        list-style: none;
        padding: 0;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        font-size: 12px;
        text-transform: uppercase;
        color: #374151;
        margin-bottom: 8px;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .form-input {
        width: 100%;
        background-color: #fafafa;
        border: 1px solid #d1d5db;
        padding: 12px 16px;
        color: #111827;
        font-size: 14px;
        border-radius: 6px;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .form-input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

    .field-error {
        color: #dc2626;
        font-size: 12px;
        margin-top: 5px;
        display: block;
    }

    .forgot-password {
        text-align: right;
        margin-bottom: 20px;
    }

        .forgot-password a {
            color: #6b7280;
            font-size: 13px;
            text-decoration: none;
        }

            .forgot-password a:hover {
                color: #2563eb;
            }

    .btn-submit {
        width: 100%;
        background-color: #0f172a;
        color: white;
        font-weight: 700;
        text-transform: uppercase;
        padding: 14px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 14px;
        letter-spacing: 0.5px;
        transition: background-color 0.2s, transform 0.1s;
    }

        .btn-submit:hover {
            background-color: #2563eb;
        }

    .auth-switch {
        text-align: center;
        margin-top: 24px;
        font-size: 13px;
        color: #4b5563;
    }

        .auth-switch a {
            color: #2563eb;
            text-decoration: none;
            font-weight: 600;
        }

            .auth-switch a:hover {
                text-decoration: underline;
            }
</style>