@model BE1.Models.viewmodel.HomeProductVM

<style>
    /* Bố cục lưới sản phẩm */
    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    /* Khung thẻ sản phẩm */
    .product-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 15px;
        position: relative;
        transition: transform 0.2s, box-shadow 0.2s;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08);
        }

        .product-card a {
            text-decoration: none;
            color: inherit;
        }

    /* Thẻ Nổi bật */
    .sale-tag {
        position: absolute;
        top: 15px;
        left: 15px;
        background: #dc2626;
        color: white;
        padding: 4px 10px;
        font-size: 11px;
        font-weight: bold;
        border-radius: 4px;
        z-index: 2;
        text-transform: uppercase;
    }

    /* Khung chứa ảnh trong thẻ sản phẩm */
    .product-card .product-photo {
        width: 100%;
        height: 180px;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        background-color: #f8fafc;
        border-radius: 8px;
        margin-bottom: 12px;
    }

        /* Ép hình ảnh tự co giãn vừa khít khung */
        .product-card .product-photo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            transition: transform 0.3s ease;
        }

    .product-card:hover .product-photo img {
        transform: scale(1.05);
    }

    /* Thông tin chữ */
    .product-info {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .product-brand {
        font-size: 12px;
        color: #64748b;
        text-transform: uppercase;
        font-weight: 600;
    }

    .product-name {
        font-size: 15px;
        font-weight: 600;
        color: #1e293b;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 40px;
    }

    .product-price-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 4px;
    }

    .product-price {
        font-size: 16px;
        font-weight: 700;
        color: #dc2626;
    }
</style>

@if (Model != null && Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
{
    <section class="section" id="best-seller">
        <div class="section-heading">
            <div>
                <h2>Sản phẩm nổi bật</h2>
                <p>Những sản phẩm được bán chạy và được đánh giá cao nhất</p>
            </div>
            <a class="see-all" href="@Url.Action("ProductList", "Home1", new { area = "Customer" })">Xem tất cả <i class="fa-solid fa-arrow-right"></i></a>
        </div>

        <div class="product-grid">
            @foreach (var item in Model.FeaturedProducts)
            {
                <div class="product-card">
                    <span class="sale-tag">Nổi bật</span>
                    <a href="@Url.Action("ProductDetails", "Home1", new { area = "Customer", id = item.ProductID })">
                        <div class="product-photo">
                            <img src="@(!string.IsNullOrEmpty(item.ProductImage) ? Url.Content(item.ProductImage) : Url.Content("~/Content/image2/thumb.jpg"))" alt="@item.ProductName" />
                        </div>
                        <div class="product-info">
                            <div class="product-brand">@(item.Category != null ? item.Category.CategoryName : "Lubu Store")</div>
                            <div class="product-name">@item.ProductName</div>
                            <div class="product-price-row">
                                <div class="product-price text-danger">@item.ProductPrice.ToString("N0") ₫</div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>
}