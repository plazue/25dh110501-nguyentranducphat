
@model BE1.Models.Product

<style>
    /* --- CSS CHO PARTIAL VIEW CHI TIẾT SẢN PHẨM --- */
    .product-detail-wrapper {
        background-color: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
        border: 1px solid #e2e8f0;
        padding: 30px;
        margin-bottom: 30px;
    }

    .product-page {
        display: flex;
        gap: 25px;
        max-width: 1200px;
        margin: 0 auto;
        color: #111;
        align-items: flex-start;
        background: #fff;
        padding: 10px 0;
    }

    .thumb {
        display: flex;
        flex-direction: column;
        gap: 10px;
        width: 75px;
        flex-shrink: 0;
        max-height: 350px;
        overflow-y: auto;
    }

    .box {
        width: 75px;
        height: 75px;
        border: 1px solid #ddd;
        border-radius: 6px;
        overflow: hidden;
        cursor: pointer;
        opacity: 0.7;
        transition: all 0.2s;
        background: #f8fafc;
        flex-shrink: 0;
    }

        .box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .box:hover, .box.active {
            border-color: #2563eb;
            opacity: 1;
            box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.2);
        }

    .product-showcase {
        flex: 1.2;
        border: 1px solid #eee;
        border-radius: 12px;
        padding: 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #fff;
        max-width: 450px;
        overflow: hidden;
    }

    .showcase-wrapper {
        position: relative;
        width: 100%;
    }

    .main-image {
        width: 100%;
        max-height: 380px;
        object-fit: contain;
        display: block;
        border-radius: 6px;
    }

    .product-details {
        flex: 1.3;
        padding-top: 5px;
    }

    .product-brand {
        font-size: 13px;
        color: #666;
        margin-bottom: 6px;
        display: block;
        text-transform: uppercase;
        font-weight: 600;
    }

    .product-title {
        font-size: 22px;
        font-weight: 700;
        margin: 0 0 12px 0;
        line-height: 1.35;
        color: #1e293b;
    }

    .product-rating {
        font-size: 14px;
        margin-bottom: 15px;
        color: #64748b;
    }

    .product-price-box {
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .current-price {
        font-size: 24px;
        font-weight: 700;
        color: #dc2626;
        margin-bottom: 0;
    }

    .product-stock {
        font-size: 14px;
        color: #0369a1;
        background-color: #e0f2fe;
        padding: 4px 10px;
        border-radius: 20px;
        display: inline-block;
        font-weight: 600;
    }

    .divider {
        border: none;
        border-top: 1px solid #eee;
        margin: 20px 0;
    }

    .thongtin {
        font-size: 15px;
        color: #475569;
        line-height: 1.6;
        margin-top: 10px;
        padding: 15px;
        background-color: #f8fafc;
        border-radius: 8px;
        border-left: 4px solid #2563eb;
    }

    .product-specs-container {
        max-width: 100%;
        margin: 30px 0 0 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .spec-row {
        display: flex;
        padding: 15px 0;
        border-bottom: 1px solid #eee;
        align-items: flex-start;
    }

    .spec-label {
        width: 220px;
        font-weight: 600;
        color: #111;
        font-size: 15px;
    }

    .spec-value {
        flex: 1;
        color: #333;
        font-size: 15px;
        line-height: 1.6;
        white-space: pre-line;
    }
</style>

<div class="product-detail-wrapper">
    <div class="product-page">
        <!-- Thumbnail Gallery -->
        <div class="thumb">
            @if (!string.IsNullOrEmpty(Model.ProductImage))
            {
                <div class="box active" onclick="changeMainImage(this, '@Url.Content(Model.ProductImage)')">
                    <img src="@Url.Content(Model.ProductImage)" alt="Main Thumb">
                </div>
            }
        </div>

        <!-- Main Showcase Image -->
        <div class="product-showcase">
            <div class="showcase-wrapper">
                <img id="mainProductImage" src="@(!string.IsNullOrEmpty(Model.ProductImage) ? Url.Content(Model.ProductImage) : Url.Content("~/Content/image2/5.jpg"))" alt="Main Image" class="main-image">
            </div>
        </div>

        <!-- Product Info Details -->
        <div class="product-details">
            <span class="product-brand">@(Model.Category != null ? Model.Category.CategoryName : "")</span>
            <h1 class="product-title">@Model.ProductName</h1>

            <div class="product-rating">
                <span class="stars">⭐ 5.0</span>
                <span class="reviews">(Chủng loại: @(Model.Category != null ? Model.Category.CategoryName : "N/A"))</span>
            </div>

            <!-- Giá tiền -->
            <div class="product-price-box">
                <span class="current-price" style="color: #2563eb;">@string.Format("{0:N0} ₫", Model.ProductPrice)</span>
            </div>

            <!-- Tồn kho -->
            <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 15px;">
                <span class="product-stock">Tồn kho: @Model.Quantity sản phẩm</span>
            </div>

            <hr class="divider">

            <div class="thongtin">
                @(string.IsNullOrEmpty(Model.ProductDecription) ? "Chưa có mô tả chi tiết cho sản phẩm này." : Model.ProductDecription)
            </div>
        </div>
    </div>

    <!-- Bảng thông số kỹ thuật -->
    <div class="product-specs-container">
        <div class="spec-row">
            <div class="spec-label">Mã sản phẩm</div>
            <div class="spec-value">#@Model.ProductID</div>
        </div>
        <div class="spec-row">
            <div class="spec-label">Chủng loại</div>
            <div class="spec-value">@(Model.Category != null ? Model.Category.CategoryName : "N/A")</div>
        </div>
        <div class="spec-row">
            <div class="spec-label">Số lượng tồn kho</div>
            <div class="spec-value">@Model.Quantity</div>
        </div>
        <div class="spec-row">
            <div class="spec-label">Mô tả chi tiết</div>
            <div class="spec-value">@(string.IsNullOrEmpty(Model.ProductDecription) ? "Không có thông tin mô tả." : Model.ProductDecription)</div>
        </div>
    </div>
</div>

<script>
    function changeMainImage(element, imgUrl) {
        document.getElementById('mainProductImage').src = imgUrl;
        var boxes = document.querySelectorAll('.thumb .box');
        boxes.forEach(function (box) {
            box.classList.remove('active');
        });
        element.classList.add('active');
    }
</script>