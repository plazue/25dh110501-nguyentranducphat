@model BE1.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-order-detail-container" style="max-width: 950px; margin: 20px auto; background: #fff; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border: 1px solid #e2e8f0;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; border-bottom: 1px solid #f1f5f9; padding-bottom: 15px;">
        <div>
            <h2 style="font-size: 22px; font-weight: 700; color: #1e293b; margin-bottom: 4px;">Chi tiết đơn hàng #@Model.OrderID</h2>
            <p style="color: #64748b; font-size: 13px; margin: 0;">Xem thông tin sản phẩm và trạng thái đơn hàng của khách hàng</p>
        </div>
        <div>
            @Html.ActionLink("Chỉnh sửa", "Edit", new { id = Model.OrderID }, new { @class = "btn-edit" })
            @Html.ActionLink("← Quay lại danh sách", "Index", null, new { @class = "btn-back" })
        </div>
    </div>

    <!-- Nhúng Partial View hiển thị nội dung chi tiết đơn hàng -->
    @Html.Partial("~/Areas/Customer/Views/Shared/_OrderDetailContent.cshtml", Model)
</div>

<style>
    .btn-edit {
        background-color: #2563eb;
        color: white;
        padding: 8px 16px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 13px;
        text-decoration: none;
        transition: background 0.2s;
        display: inline-block;
    }

        .btn-edit:hover {
            background-color: #1d4ed8;
            color: white;
            text-decoration: none;
        }

    .btn-back {
        background-color: #f1f5f9;
        color: #475569;
        padding: 8px 16px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 13px;
        text-decoration: none;
        transition: background 0.2s;
        display: inline-block;
        margin-left: 8px;
    }

        .btn-back:hover {
            background-color: #e2e8f0;
            color: #1e293b;
            text-decoration: none;
        }
</style>