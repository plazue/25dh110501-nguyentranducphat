@model BE1.Models.Customer

@{
    ViewBag.Title = "Chi tiết tài khoản khách hàng - Lubu Store";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="detail-container">
    <div class="detail-header">
        <h2>Chi tiết tài khoản admin</h2>
        <p>Thông tin hồ sơ và trạng thái hoạt động của người dùng trong hệ thống</p>
    </div>

    <div class="detail-card">
        <div class="detail-grid">
            <div class="detail-item">
                <span class="detail-label">Tên đăng nhập (Username)</span>
                <span class="detail-value highlight">@Model.Username</span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Họ và tên</span>
                <span class="detail-value">@Model.CustomerName</span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Địa chỉ Email</span>
                <span class="detail-value">@Model.CustomerEmail</span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Số điện thoại</span>
                <span class="detail-value">@(string.IsNullOrEmpty(Model.CustomerPhone) ? "Chưa cập nhật" : Model.CustomerPhone)</span>
            </div>

            <div class="detail-item full-width">
                <span class="detail-label">Địa chỉ nhận hàng</span>
                <span class="detail-value">@(string.IsNullOrEmpty(Model.CustomerAddress) ? "Chưa cập nhật" : Model.CustomerAddress)</span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Quyền hạn (Role)</span>
                <span class="detail-value">
                    <span class="badge-role @(Model.Role == "Admin" ? "badge-admin" : "badge-customer")">
                        @(string.IsNullOrEmpty(Model.Role) ? "Customer" : Model.Role)
                    </span>
                </span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Trạng thái tài khoản</span>
                <span class="detail-value">
                    @if (Model.IsActive == true)
                    {
                        <span class="badge-status badge-active">Hoạt động</span>
                    }
                    else
                    {
                        <span class="badge-status badge-locked">Đã khóa</span>
                    }
                </span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Mật khẩu</span>
                <span class="detail-value password-mask">••••••••</span>
            </div>

            @if (!string.IsNullOrEmpty(Model.CustomerImage))
            {
                <div class="detail-item full-width">
                    <span class="detail-label">Ảnh đại diện</span>
                    <div style="margin-top: 6px;">
                        <img src="@Url.Content(Model.CustomerImage)" alt="Avatar" style="width: 60px; height: 60px; object-fit: cover; border-radius: 50%; border: 1px solid #cbd5e1;" />
                    </div>
                </div>
            }
        </div>

        <div class="detail-actions">
            @Html.ActionLink("Chỉnh sửa", "Edit", new { id = Model.CustomerID }, new { @class = "btn-edit" })
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn-back" })
        </div>
    </div>
</div>

<style>
    .detail-container {
        max-width: 800px;
        margin: 20px auto;
        padding: 0 15px;
    }

    .detail-header {
        margin-bottom: 24px;
    }

        .detail-header h2 {
            font-size: 22px;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 4px;
        }

        .detail-header p {
            color: #64748b;
            font-size: 13px;
        }

    .detail-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    }

    .detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 30px;
    }

    .detail-item {
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        border-radius: 8px;
        padding: 14px 16px;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .detail-item.full-width {
            grid-column: span 2;
        }

    .detail-label {
        font-size: 12px;
        text-transform: uppercase;
        font-weight: 600;
        color: #64748b;
        letter-spacing: 0.5px;
    }

    .detail-value {
        font-size: 15px;
        color: #0f172a;
        font-weight: 500;
    }

        .detail-value.highlight {
            color: #2563eb;
            font-weight: 600;
        }

    .password-mask {
        letter-spacing: 2px;
        color: #475569;
    }

    /* Badges */
    .badge-role {
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .badge-admin {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .badge-customer {
        background: #f1f5f9;
        color: #475569;
    }

    .badge-status {
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .badge-active {
        background: #dcfce7;
        color: #15803d;
    }

    .badge-locked {
        background: #fee2e2;
        color: #dc2626;
    }

    /* Actions */
    .detail-actions {
        display: flex;
        gap: 12px;
        border-top: 1px solid #f1f5f9;
        padding-top: 20px;
    }

    .btn-edit {
        background-color: #2563eb;
        color: white;
        padding: 10px 20px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        transition: background 0.2s;
        display: inline-block;
    }

        .btn-edit:hover {
            background-color: #1d4ed8;
            color: white;
            text-decoration: none;
        }

    .btn-back {
        background-color: #f1f5f9;
        color: #475569;
        padding: 10px 20px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        transition: background 0.2s;
        display: inline-block;
    }

        .btn-back:hover {
            background-color: #e2e8f0;
            color: #1e293b;
            text-decoration: none;
        }
</style>